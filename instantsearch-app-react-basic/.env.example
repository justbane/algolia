# Copy this file to ".env" and fill in your own Algolia credentials.
# The values below point at Algolia's public demo dataset so the app
# runs out of the box. Swap them for your own application when demoing.

# Your Algolia Application ID (Dashboard > Settings > API Keys)
VITE_ALGOLIA_APP_ID=latency

# A Search-only API key -- safe to expose in the browser. Never use the Admin key here.
VITE_ALGOLIA_API_KEY=6be0576ff61c053d5f9a3225e2a90f76

# The index that backs the product list and the facets
VITE_ALGOLIA_INDEX_NAME=instant_search

# A Query Suggestions index (Dashboard > Search > Query Suggestions)
VITE_ALGOLIA_SUGGESTIONS_INDEX_NAME=instant_search_demo_query_suggestions
